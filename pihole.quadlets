# FileName=pihole
[Unit]
Description=Pi-Hole on HUM core-runtime

[Container]
ContainerName=pihole
Image=ghcr.io/nzwulfin/pihole:latest
Pod=pihole.pod
Volume=systemd-pihole-etc:/etc/pihole:z
Volume=systemd-pihole-dnsmasq:/etc/dnsmasq.d:z
Environment=TZ="America/New_York"
AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
---
# FileName=pihole-pod
[Pod]
PublishPort=8086:80
PublishPort=53:53/tcp
PublishPort=53:53/udp
---
#FileName=pihole-unbound
[Unit]
Description=Unbound recursive DNS for Pi-hole

[Container]
Pod=pihole.pod
ContainerName=unbound-pihole
Image=ghcr.io/nzwulfin/unbound:latest
AddCapability=CAP_NET_ADMIN
AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=300
 
[Install]
WantedBy=default.target
