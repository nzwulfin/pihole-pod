# syntax=docker/dockerfile:1

# Stage 1: build-time preparation
# Clone upstream repos, download binaries, extract scripts, strip .git dirs
FROM registry.access.redhat.com/hi/core-runtime:latest-builder AS builder
USER root

# renovate: datasource=github-releases depName=pi-hole/FTL
ARG FTL_VERSION=v6.7
# renovate: datasource=github-releases depName=pi-hole/pi-hole
ARG PIHOLE_CORE_VERSION=v6.4.3
# renovate: datasource=github-releases depName=pi-hole/web
ARG PIHOLE_WEB_VERSION=v6.6

RUN dnf install -y \
    --setopt=install_weak_deps=False \
    --setopt=tsflags=nodocs \
    binutils \
    curl \
    git \
    && dnf clean all

RUN <<EOF
set -ex
git clone --branch ${PIHOLE_CORE_VERSION} --single-branch --depth 1 \
    https://github.com/pi-hole/pi-hole.git /etc/.pihole
git clone --branch ${PIHOLE_WEB_VERSION} --single-branch --depth 1 \
    https://github.com/pi-hole/web.git /var/www/html/admin
printf '%s\n' \
  "CORE_VERSION=$(cd /etc/.pihole && git describe --tags --always)" \
  "CORE_BRANCH=master" \
  "CORE_HASH=$(cd /etc/.pihole && git rev-parse --short=8 HEAD)" \
  "WEB_VERSION=$(cd /var/www/html/admin && git describe --tags --always)" \
  "WEB_BRANCH=master" \
  "WEB_HASH=$(cd /var/www/html/admin && git rev-parse --short=8 HEAD)" \
  > /etc/pihole.versions.build
rm -rf /etc/.pihole/.git /var/www/html/admin/.git
EOF

RUN <<EOF
set -ex
cd /etc/.pihole
install -Dm755 -d /opt/pihole
install -Dm755 -t /opt/pihole gravity.sh
install -Dm755 -t /opt/pihole ./advanced/Scripts/*.sh
install -Dm755 -t /opt/pihole ./advanced/Scripts/COL_TABLE
install -Dm755 -d /etc/pihole
install -Dm644 -t /etc/pihole ./advanced/Templates/logrotate
install -Dm755 -t /usr/local/bin pihole
install -Dm644 ./advanced/bash-completion/pihole.bash /etc/bash_completion.d/pihole
install -Dm644 ./advanced/bash-completion/pihole-ftl.bash /etc/bash_completion.d/pihole-FTL
install -T -m 0755 ./advanced/Templates/pihole-FTL-poststop.sh /opt/pihole/pihole-FTL-poststop.sh
sed -i 's/sudo -u pihole test/test/' /opt/pihole/gravity.sh
EOF

ADD https://ftl.pi-hole.net/macvendor.db /macvendor.db

RUN <<EOF
set -ex
curl -sSL \
    "https://github.com/pi-hole/ftl/releases/download/${FTL_VERSION}/pihole-FTL-amd64" \
    -o /usr/bin/pihole-FTL
chmod +x /usr/bin/pihole-FTL
readelf -h /usr/bin/pihole-FTL || (echo "Error with FTL binary" && exit 1)
FTL_VER=$(/usr/bin/pihole-FTL version 2>/dev/null) || FTL_VER="${FTL_VERSION#v}"
FTL_BR=$(/usr/bin/pihole-FTL branch 2>/dev/null) || FTL_BR="release"
FTL_HSH=$(/usr/bin/pihole-FTL --hash 2>/dev/null) || FTL_HSH="N/A"
printf '%s\n' \
  "FTL_VERSION=${FTL_VER}" \
  "FTL_BRANCH=${FTL_BR}" \
  "FTL_HASH=${FTL_HSH}" \
  >> /etc/pihole.versions.build
EOF

# Stage 2: runtime image
FROM registry.access.redhat.com/hi/core-runtime@sha256:80bd4bd4e74c8ab4e372cf355b335dbd30d91e9e5669822283299e65c64788e2

USER root

ENV DNSMASQ_USER=pihole
ENV FTL_CMD=no-daemon

# renovate: datasource=rpm depName=bind-utils
ARG BIND_UTILS_VERSION=9.18.50-22.hum1
# renovate: datasource=rpm depName=busybox
ARG BUSYBOX_VERSION=1.37.0-8.2.hum1
# renovate: datasource=rpm depName=curl
ARG CURL_VERSION=8.21.0-0.1.1.hum1
# renovate: datasource=rpm depName=iproute
ARG IPROUTE_VERSION=7.0.0-2.hum1
# renovate: datasource=rpm depName=logrotate
ARG LOGROTATE_VERSION=3.22.0-6.hum1
# renovate: datasource=rpm depName=tzdata
ARG TZDATA_VERSION=2026b-2.hum1

RUN --mount=type=bind,from=registry.access.redhat.com/hi/core-runtime:latest-builder,target=/builder \
    LD_LIBRARY_PATH=/builder/lib64:/builder/usr/lib64 \
    RPM_CONFIGDIR=/builder/usr/lib/rpm \
    /builder/usr/bin/dnf install -y \
    --installroot=/ \
    --setopt=reposdir=/builder/etc/yum.repos.d \
    --setopt=install_weak_deps=False \
    --setopt=tsflags=nodocs \
    bind-utils-${BIND_UTILS_VERSION} \
    busybox-${BUSYBOX_VERSION} \
    curl-${CURL_VERSION} \
    iproute-${IPROUTE_VERSION} \
    logrotate-${LOGROTATE_VERSION} \
    tzdata-${TZDATA_VERSION}

RUN echo "pihole:x:1000:1000:Pi-hole:/:/sbin/nologin" >> /etc/passwd \
    && echo "pihole:x:1000:" >> /etc/group

# Busybox provides find, sed, and awk but the RPM does not create symlinks.
# Create them here so upstream pi-hole scripts (gravity.sh etc.) can call these
# tools by name without modification.
RUN <<EOF
ln -sf /usr/bin/busybox /usr/bin/find
ln -sf /usr/bin/busybox /usr/bin/sed
ln -sf /usr/bin/busybox /usr/bin/awk
ln -sf /usr/bin/busybox /usr/bin/uptime
EOF

COPY --from=builder /usr/bin/pihole-FTL /usr/bin/pihole-FTL
COPY --from=builder /macvendor.db /macvendor.db
COPY --from=builder /etc/.pihole/ /etc/.pihole/
COPY --from=builder /var/www/html/admin/ /var/www/html/admin/
COPY --from=builder /opt/pihole/ /opt/pihole/
COPY --from=builder /usr/local/bin/pihole /usr/local/bin/pihole
COPY --from=builder /etc/bash_completion.d/ /etc/bash_completion.d/
COPY --from=builder /etc/pihole/logrotate /etc/pihole/logrotate
COPY --from=builder /etc/pihole.versions.build /etc/pihole.versions.build

RUN install -Dm755 -d /var/log/pihole \
    && install -Dm755 -d /var/lib/logrotate

COPY --chmod=0755 bash_functions.sh /usr/bin/bash_functions.sh
COPY --chmod=0755 prefix-time.sh /usr/bin/prefix-time.sh
COPY --chmod=0755 start.sh /usr/bin/start.sh
COPY --chmod=0755 pihole-FTL-prestart.sh /opt/pihole/pihole-FTL-prestart.sh
COPY crontab.txt /crontab.txt

EXPOSE 53 53/udp
EXPOSE 80

HEALTHCHECK CMD dig -p $(pihole-FTL --config dns.port) +short +norecurse +retry=0 @127.0.0.1 pi.hole || exit 1

ENTRYPOINT ["start.sh"]
