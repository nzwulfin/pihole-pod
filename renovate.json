{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "workarounds:supportRedHatImageVersion"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/hi/**"],
      "versioning": "redhat"
    },
    {                                                                                                               
      "matchManagers": ["custom.regex"],                                                                                
      "matchFileNames": ["pihole/Containerfile"],                                                                   
      "groupName": "pihole dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track ARG-pinned versions (FTL, pihole-core, pihole-web)",
      "managerFilePatterns": [
        "/^pihole/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
