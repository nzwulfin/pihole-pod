{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "workarounds:supportRedHatImageVersion"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/hi/**"],
      "versioning": "redhat"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^pihole/Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
