{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "workarounds:supportRedHatImageVersion"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/hi/**"],
      "versioning": "redhat",
      "automerge": true,
      "automergeStrategy": "merge-commit",
      "labels": ["chore"]
    },
    {
      "matchDatasources": ["rpm"],
      "versioning": "rpm",
      "registryUrls": ["https://packages.redhat.com/api/pulp-content/public-hummingbird/x86_64/repodata/"]
    },
    {
      "matchFileNames": ["pihole/Containerfile"],
      "groupName": "pihole image"
    },
    {
      "matchFileNames": ["unbound/Containerfile"],
      "groupName": "unbound image"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "automergeStrategy": "merge-commit",
      "labels": ["chore"]
    },
    {
      "description": "Carried app — human review per #221: broad behavior space CI only samples",
      "matchDepNames": ["pi-hole/pi-hole", "pi-hole/FTL"],
      "groupName": "pihole app",
      "automerge": false
    },
    {
      "description": "Chore pins — merge on green per #221: narrow, CI-observable breakage modes",
      "matchDepNames": ["pi-hole/web", "busybox", "bash", "curl", "iproute", "logrotate", "tzdata", "sudo"],
      "groupName": "pihole chores",
      "automerge": true,
      "automergeStrategy": "merge-commit",
      "labels": ["chore"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track ARG-pinned versions (github-releases and rpm)",
      "managerFilePatterns": [
        "/^pihole/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
