{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "workarounds:supportRedHatImageVersion"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/hi/**"],
      "versioning": "redhat"
    },
    {
      "matchDatasources": ["rpm"],
      "versioning": "rpm",
      "registryUrls": ["https://packages.redhat.com/api/pulp-content/public-hummingbird/x86_64/repodata/"]
    },
    {
      "matchFileNames": ["pihole/Containerfile"],
      "groupName": "pihole image"
    },
    {
      "matchFileNames": ["unbound/Containerfile"],
      "groupName": "unbound image"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track ARG-pinned versions (github-releases and rpm)",
      "managerFilePatterns": [
        "/^pihole/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
